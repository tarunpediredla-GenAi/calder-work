# GEMINI_API_KEY: Required for server-side Gemini calls (both preview Express routes and local FastAPI LangGraph agents).
# Keep strictly on the server; never expose to the browser.
GEMINI_API_KEY=

# APP_URL: Public URL where Calder Works is hosted.
APP_URL=http://localhost:3000

# Workspace mode: "demo" (default in preview when Docker/GitHub are unavailable) or "connected" (local FastAPI + PostgreSQL + GitHub).
CALDER_WORKSPACE_MODE=demo

# GitHub integration (server-side only; required for connected mode branch creation, commits, and draft PRs).
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_DEFAULT_ORG=calder-clients

# PostgreSQL persistence (used by docker-compose.yml and backend/ FastAPI service).
POSTGRES_USER=calder
POSTGRES_PASSWORD=calder_local_dev_only
POSTGRES_DB=calder_works
DATABASE_URL=postgresql+asyncpg://calder:calder_local_dev_only@postgres:5432/calder_works

# Isolated test runner configuration (generated code runs with --network=none and stripped environment).
CALDER_SANDBOX_IMAGE=calder-works-sandbox:latest
CALDER_SANDBOX_TIMEOUT_SECONDS=90
CALDER_MAX_AUTO_CORRECTIONS=2

# Optional FastAPI backend URL when running frontend against local Python backend.
CALDER_FASTAPI_URL=http://localhost:8000
